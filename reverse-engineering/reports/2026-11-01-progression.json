  "rules": {
    "state_u32_fields": {
      "level": 1336,
      "xp": 1340,
      "pending_upgrades": 2088
    },
    "xp_add": "xp = (xp + amount) & 0xffffffff before the loop, even at level99 or above",
    "threshold_order": [
      "n = u32_to_f32(level - (level != 0))",
      "linear = f32_add(f32_mul(n, f32(4)), f32(5))",
      "quadratic = f32_mul(f32_mul(n, bits0x3eb33333), n)",
      "rounded = round85387(f32_add(linear, quadratic))",
      "threshold = i32.trunc_sat_f32_u(rounded)"
    ],
    "loop": "while unsigned(level)<=98 and unsigned(xp)>=threshold: level+=1; xp-=threshold; pending=(pending+1)&0xffffffff; recompute threshold",
    "cap_qualification": "Valid initial levels0..99 cannot exceed99. Inputs>=99 are retained without clamping; XP addition still wraps.",
    "pending_qualification": "The model tracks increments only. It does not consume pending choices or run2098.",
    "card_guard": "pending!=0 && phase2299==1 && !(flags2288&1) && (gate2284!=1 || (flags2285&1))",
    "round85387": {
      "signed_addend_absolute_bits": "0x3effffff",
      "signed_addend_absolute_exact_decimal": "0.4999999701976776123046875",
      "steps": [
        "add x and copysign(addend,x) with binary32 RNE",
        "extract biased exponent e from the sum",
        "if e>149 return the sum",
        "if e<127 retain only sign bit, else retain sum & (signed(-8388608) >> (e-127))"
      ],
      "nan_policy": "Category only; payload/sign/signaling are not promised."
    },
    "excluded_side_effects": [
      "1573 attribute recomputation",
      "level-up healing and dependent attributes",
      "3736 field notifications and other messages",
      "HUD serialization as a whole",
      "2098 card generation/consumption and actual item effects"
    ],
    "initial_level_policy": "No inferred game-start level; both0 and1 are admitted and have threshold5."
  },
